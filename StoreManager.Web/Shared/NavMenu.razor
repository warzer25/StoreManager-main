@using StoreManager.Web.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="Icons.Material.Filled.Home">
        Home
    </MudNavLink>

    @if (AuthService.IsAuthenticated)
    {
        <MudNavLink Href="categories" Icon="Icons.Material.Filled.Category">
            Categories
        </MudNavLink>

        @if (AuthService.IsAdmin)
        {
            <div class="nav-item px-3">
                <MudNavLink Href="products" Icon="Icons.Material.Filled.Inventory">
                    Products
                </MudNavLink>
            </div>
            
            <MudNavLink Href="orders" Icon="Icons.Material.Filled.ShoppingCart">
                Orders
            </MudNavLink>
            <MudNavLink Href="users" Icon="Icons.Material.Filled.People">
                Users
            </MudNavLink>
            <MudNavLink Href="reports" Icon="Icons.Material.Filled.BarChart">
                Reports
            </MudNavLink>
        }

        @if (AuthService.IsCashier)
        {
            <MudNavLink Href="pos" Icon="Icons.Material.Filled.PointOfSale">
                Point of Sale
            </MudNavLink>
        }

        <MudDivider Class="my-2" />

        <MudNavLink @onclick="Logout" Icon="Icons.Material.Filled.Logout">
            Logout (@AuthService.CurrentUser?.Name)
        </MudNavLink>
    }
    else
    {
        <MudNavLink Href="login" Icon="Icons.Material.Filled.Login">
            Login
        </MudNavLink>
    }
</MudNavMenu>

@code {
    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}